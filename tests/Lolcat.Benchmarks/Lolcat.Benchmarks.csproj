<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <ApplicationIcon>..\..\assets\Rainbow.ico</ApplicationIcon>
    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>
    <!-- CA1707 (no underscores in member names) would rename the benchmarks, and the method
         name is the series key in the gh-pages benchmark history. -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Lolcat\Lolcat.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shares the test double without referencing the test project, which is an xunit.v3
         executable with its own entry point. -->
    <Compile Include="..\Lolcat.Tests\MockConsole.cs" Link="MockConsole.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
    <PackageReference Include="Spectre.Console" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="BenchmarkDotNet.Attributes" />
    <Using Include="BenchmarkDotNet.Columns" />
    <Using Include="BenchmarkDotNet.Configs" />
    <Using Include="BenchmarkDotNet.Diagnosers" />
    <Using Include="BenchmarkDotNet.Environments" />
    <Using Include="BenchmarkDotNet.Exporters.Json" />
    <Using Include="BenchmarkDotNet.Jobs" />
    <Using Include="BenchmarkDotNet.Running" />
    <Using Include="Lolcat.Benchmarks" />
    <Using Include="Lolcat.Tests" />
    <Using Include="Spectre.Console" />
    <Using Include="System.Runtime.InteropServices" />
    <Using Include="System.Text" />
    <Using Include="System.Text.Json.Nodes" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\assets\Rainbow.ico">
      <Link>Rainbow.ico</Link>
    </None>
  </ItemGroup>

</Project>
